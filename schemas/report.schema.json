{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunglam0605.github.io/engineering-report-stack/schemas/report.schema.json",
  "title": "Engineering Report Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^RPT-[A-Z0-9][A-Z0-9-]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "status": {"enum": ["draft", "review", "released", "archived"]},
    "renderers": {
      "type": "array",
      "items": {"enum": ["vitepress", "quarto", "observable", "evidence", "slidev", "revealjs"]},
      "uniqueItems": true
    },
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
