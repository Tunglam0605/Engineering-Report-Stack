{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunglam0605.github.io/engineering-report-stack/schemas/test.schema.json",
  "title": "Test",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "verifies", "method", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^TEST-[A-Z0-9][A-Z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "verifies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^REQ-"}
    },
    "method": {"type": "string", "minLength": 1},
    "procedure": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "string"},
    "status": {"enum": ["planned", "ready", "running", "completed", "deprecated"]},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
