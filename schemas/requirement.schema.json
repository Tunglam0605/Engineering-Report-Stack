{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tunglam0605.github.io/engineering-report-stack/schemas/requirement.schema.json",
  "title": "Requirement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "statement", "status", "source_refs"],
  "properties": {
    "id": {"type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "verified", "accepted", "deprecated"]},
    "acceptance": {"type": "string"},
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^(STD|SRC)-"},
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "clause": {"type": "string"},
              "page": {"type": ["integer", "string"]},
              "section": {"type": "string"},
              "anchor": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        }
      }
    },
    "implemented_by": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metadata": {"type": "object", "additionalProperties": true}
  }
}
